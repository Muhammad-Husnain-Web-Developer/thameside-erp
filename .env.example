APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ERP company profile (replace sample values before creating real documents).
ERP_COMPANY_NAME="Thameside Kitchen Supply Ltd"
ERP_COMPANY_SHORT_NAME="Thameside Kitchen Supply"
ERP_COMPANY_TAGLINE="Kitchen appliance wholesale - London"
ERP_COMPANY_ADDRESS_LINE_1="Unit 14, Bankside Wharf"
ERP_COMPANY_ADDRESS_LINE_2="Mill Lane"
ERP_COMPANY_CITY=London
ERP_COMPANY_POSTCODE="SE1 2QT"
ERP_COMPANY_COUNTRY="United Kingdom"
ERP_COMPANY_EMAIL=orders@thamesidekitchen.co.uk
ERP_COMPANY_PHONE="+44 20 7946 0311"
ERP_COMPANY_VAT_NUMBER="GB 452 8891 07"
ERP_COMPANY_NUMBER=09214478
ERP_COMPANY_BANK_NAME="Lloyds Bank"
ERP_COMPANY_BANK_SORT_CODE="30-96-14"
ERP_COMPANY_BANK_ACCOUNT=41882063

# Currency and tax. VAT basis points: 2000 = 20%.
ERP_CURRENCY=GBP
ERP_CURRENCY_SYMBOL="£"
ERP_VAT_RATE_BPS=2000
ERP_VAT_RATE_LABEL="20%"
ERP_PAYMENT_TERMS_DAYS=30
ERP_LOW_STOCK_THRESHOLD=10

# Optional document number prefixes.
ERP_PREFIX_QUOTE=QUO
ERP_PREFIX_SALES_ORDER=SO
ERP_PREFIX_INVOICE=INV
ERP_PREFIX_CREDIT_NOTE=CRN
ERP_PREFIX_PURCHASE_ORDER=PO
ERP_PREFIX_GOODS_RECEIPT=GRN
ERP_PREFIX_BILL=BILL
ERP_PREFIX_JOURNAL=JE
ERP_PREFIX_PAYMENT=PAY

# Optional: OpenAI-compatible provider for the read-only AI insights page.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
